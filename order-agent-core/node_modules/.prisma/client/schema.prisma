// Prisma Schema for KARIBU Order Management Core
// Derived directly from the KARIBU GraphQL API schema specifications.
// Supports offline testing, migrations, and realistic mock data generation.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// 1. Reference & Lookup Enums / Status Tables
// ----------------------------------------------------------------------------

model Country {
  id          Int       @id
  name        String
  alpha2      String    @unique
  alpha3      String    @unique
  callingCode String?
  cluster     Int?
  companies   Company[]
  banks       Bank[]
  vehicles    Vehicle[]
  drivers     Driver[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Company {
  id                     Int                 @id
  code                   String              @unique
  name                   String
  countryId              Int
  country                Country             @relation(fields: [countryId], references: [id])
  email                  String?
  telephoneNumber        String?
  customerTranscription  Boolean             @default(true)
  defaultCurrencyCode    String              @default("GHS")
  defaultCurrencySymbol  String              @default("GH₵")
  allowDepotSelection    Boolean             @default(true)
  allowOrderCancellation Boolean             @default(true)
  allowOrderAmendment    Boolean             @default(false)
  users                  User[]
  locations              Location[]
  customers              Customer[]
  products               Product[]
  destinations           Destination[]
  paymentModes           PaymentMode[]
  salesVouchers          SalesVoucher[]
  salesVoucherOrders     SalesVoucherOrder[]
  basketOrders           BasketOrder[]
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model Location {
  id                                    Int                 @id
  code                                  String
  name                                  String
  companyId                             Int
  company                               Company             @relation(fields: [companyId], references: [id])
  type                                  String?             @default("PLANT") // "PLANT" or "DEPOT"
  allowDeliveryTypeSelection            Boolean             @default(true)
  allowDeliveryTypeSelectionForProduct  Boolean             @default(false)
  defaultDeliveryType                   String?             @default("EXW") // "EXW" or "DELIVERED"
  useLocalPoNumber                      Boolean             @default(false)
  useFileUpload                         Boolean             @default(true)
  requireFileUpload                     Boolean             @default(false)
  useDescription                        Boolean             @default(true)
  useComments                           Boolean             @default(true)
  useDeliveryContact                    Boolean             @default(true)
  useConfirmQuotation                   Boolean             @default(true)
  useDeliveredOrderManagement           Boolean             @default(true)
  requireDestinationSelectionForExworks Boolean             @default(false)
  users                                 User[]
  sourceVouchers                        SalesVoucher[]      @relation("SourceLocation")
  salesVoucherItems                     SalesVoucherItem[]  @relation("ItemSourceLocation")
  salesVoucherOrders                    SalesVoucherOrder[]
  createdAt                             DateTime            @default(now())
  updatedAt                             DateTime            @updatedAt
}

model Destination {
  id                 Int                 @id
  code               String
  name               String
  region             String?
  country            String?
  companyId          Int
  company            Company             @relation(fields: [companyId], references: [id])
  minDeliveryDays    Float?              @default(2.0)
  distance           Float?
  salesVouchers      SalesVoucher[]
  salesVoucherItems  SalesVoucherItem[]
  salesVoucherOrders SalesVoucherOrder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// ----------------------------------------------------------------------------
// 2. Status & Code Dictionaries (mirrors GraphQL dictionary IDs)
// ----------------------------------------------------------------------------

model SalesVoucherStatus {
  id             Int            @id // 0: WaitingForQuotation, 1: Quotation, 8: PaymentSubmitted, 9: SOGenerated, 10: QuotationGenerated, 12: Pending...
  description    String
  translationKey String?
  salesVouchers  SalesVoucher[]
}

model SalesVoucherOrderStatus {
  id                 Int                 @id // 10: Unconfirmed, 20: Confirmed, 30: Cancelled, 40: Dispatched, 50: Delivered
  description        String
  salesVoucherOrders SalesVoucherOrder[]
}

model BasketOrderStatus {
  id           Int           @id // 1: Open, 2: InProgress, 3: Completed, 4: Expired
  description  String
  basketOrders BasketOrder[]
}

model PaymentStatus {
  id             Int       @id // 1: Pending, 2: Approved, 3: Rejected, 4: Cancelled, 5: Closed, 6: TranscriptionRequired
  description    String
  translationKey String?
  payments       Payment[]
}

model DocumentType {
  id                    Int                    @id // 1: EPayment, 2: CashDepositSlip, 3: ChequeDepositSlip, 4: Cheque, 5: HaulageClaim, 6: CreditOrder, 7: BankTransferNote, 8: EndorsedDraft, 9: AvailableBalance
  description           String
  translationKey        String?
  paymentModes          PaymentMode[]
  paymentTranscriptions PaymentTranscription[]
}

// ----------------------------------------------------------------------------
// 3. Banking & Payment Configurations
// ----------------------------------------------------------------------------

model Bank {
  id                    Int                    @id
  name                  String
  code                  String
  countryId             Int
  country               Country                @relation(fields: [countryId], references: [id])
  isActive              Boolean                @default(true)
  bankBranches          BankBranch[]
  paymentTranscriptions PaymentTranscription[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model BankBranch {
  id                    Int                    @id
  name                  String
  code                  String?
  bankId                Int
  bank                  Bank                   @relation(fields: [bankId], references: [id])
  isActive              Boolean                @default(true)
  paymentTranscriptions PaymentTranscription[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model PaymentMode {
  id                  Int          @id
  name                String
  documentTypeId      Int
  documentType        DocumentType @relation(fields: [documentTypeId], references: [id])
  companyId           Int
  company             Company      @relation(fields: [companyId], references: [id])
  paymentModeTypeId   Int          @default(2) // 1: E-Payment, 2: Manual/Other
  paymentModeStatusId Int          @default(1) // 1: Active
  payments            Payment[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

// ----------------------------------------------------------------------------
// 4. Master Entities: Products, Customers, Users, Vehicles & Drivers
// ----------------------------------------------------------------------------

model Product {
  id                 Int                 @id
  itemCode           String
  title              String
  productGroup       String?             @default("Cement Bags")
  standardUnit       String?             @default("bags")
  weighPiece         Float?              @default(50.0) // 50kg per bag
  unitPrice          Float?              @default(90.0) // estimated unit price in local currency
  description        String?
  isPublished        Boolean             @default(true)
  companyId          Int
  company            Company             @relation(fields: [companyId], references: [id])
  salesVoucherItems  SalesVoucherItem[]
  salesVoucherOrders SalesVoucherOrder[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Customer {
  id                      Int                 @id
  customerCode            String              @unique
  customerName            String
  email                   String?
  phoneNumber             String?
  companyId               Int
  company                 Company             @relation(fields: [companyId], references: [id])
  customerAccountBalance  Float               @default(0.0)
  customerAvailableCredit Float               @default(0.0)
  customerCrLimit         Float               @default(0.0)
  customerOpenOrders      Float               @default(0.0)
  customerStatus          Int?                @default(1)
  customerStatusDesc      String?             @default("Active")
  customerCurrency        String?             @default("GHS")
  active                  Boolean             @default(true)
  users                   User[]
  salesVouchers           SalesVoucher[]
  salesVoucherOrders      SalesVoucherOrder[]
  basketOrders            BasketOrder[]
  payments                Payment[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
}

model User {
  id              String         @id @default(uuid())
  userName        String         @unique
  fullName        String?
  email           String         @unique
  phoneNumber     String?
  isActive        Boolean        @default(true)
  companyId       Int?
  company         Company?       @relation(fields: [companyId], references: [id])
  customerId      Int?
  customer        Customer?      @relation(fields: [customerId], references: [id])
  locationId      Int?
  location        Location?      @relation(fields: [locationId], references: [id])
  role            String?        @default("CUSTOMER") // "CUSTOMER", "SALES_OFFICER", "ADMIN"
  createdVouchers SalesVoucher[]
  createdBaskets  BasketOrder[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Vehicle {
  id                Int                @id @default(autoincrement())
  vehicleNo         String             @unique
  transporterCode   String?
  countryId         Int
  country           Country            @relation(fields: [countryId], references: [id])
  capacity          Float?             @default(30.0) // tons
  isActive          Boolean            @default(true)
  salesVoucherItems SalesVoucherItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Driver {
  id                Int                @id @default(autoincrement())
  firstName         String
  lastName          String
  licenseNo         String             @unique
  phoneNo           String?
  transporterCode   String?
  countryId         Int
  country           Country            @relation(fields: [countryId], references: [id])
  isActive          Boolean            @default(true)
  salesVoucherItems SalesVoucherItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// ----------------------------------------------------------------------------
// 5. Order Management: Basket, Sales Voucher, Items & Sales Orders
// ----------------------------------------------------------------------------

model BasketOrder {
  id                  Int                @id @default(autoincrement())
  basketOrderNumber   String             @unique
  totalQuantity       Float
  quantityUsed        Float              @default(0.0)
  quantityLeft        Float
  salesVoucherCount   Int                @default(0)
  customerId          Int
  customer            Customer           @relation(fields: [customerId], references: [id])
  companyId           Int
  company             Company            @relation(fields: [companyId], references: [id])
  createdById         String?
  createdBy           User?              @relation(fields: [createdById], references: [id])
  basketOrderStatusId Int                @default(1)
  basketOrderStatus   BasketOrderStatus? @relation(fields: [basketOrderStatusId], references: [id])
  salesVouchers       SalesVoucher[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model SalesVoucher {
  id                    Int                 @id @default(autoincrement())
  voucherNumber         String              @unique
  customerReference     String?
  customOrderNumber     String?
  orderQuote            Float? // backend-calculated quotation price
  customerId            Int
  customer              Customer            @relation(fields: [customerId], references: [id])
  companyId             Int
  company               Company             @relation(fields: [companyId], references: [id])
  createdById           String?
  createdBy             User?               @relation(fields: [createdById], references: [id])
  sourceLocationId      Int
  sourceLocation        Location            @relation("SourceLocation", fields: [sourceLocationId], references: [id])
  destinationId         Int?
  destination           Destination?        @relation(fields: [destinationId], references: [id])
  basketId              Int?
  basket                BasketOrder?        @relation(fields: [basketId], references: [id])
  salesVoucherStatusId  Int                 @default(12) // 12 = Pending, 1 = Quotation, 8 = PaymentSubmitted, 9 = SOGenerated
  salesVoucherStatus    SalesVoucherStatus? @relation(fields: [salesVoucherStatusId], references: [id])
  isDeliveryInclusive   Boolean             @default(false)
  localPurchaseOrder    String?
  description           String?
  comments              String?
  deliveryContact       String?
  featuredImageUrl      String?
  fileName              String?
  quotationGeneratedAt  DateTime?
  salesOrderGeneratedAt DateTime?
  items                 SalesVoucherItem[]
  salesVoucherOrders    SalesVoucherOrder[]
  payments              Payment[]
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model SalesVoucherItem {
  id                   Int                 @id @default(autoincrement())
  salesVoucherId       Int
  salesVoucher         SalesVoucher        @relation(fields: [salesVoucherId], references: [id], onDelete: Cascade)
  productId            Int
  product              Product             @relation(fields: [productId], references: [id])
  quantity             Float // Quantity per truck/sales order
  trucksCount          Int                 @default(1) // Number of trucks/sales orders
  unitPrice            Float?
  totalPrice           Float?
  discount             Float?              @default(0.0)
  tax                  Float?              @default(0.0)
  sourceLocationId     Int?
  sourceLocation       Location?           @relation("ItemSourceLocation", fields: [sourceLocationId], references: [id])
  destinationId        Int?
  destination          Destination?        @relation(fields: [destinationId], references: [id])
  isDeliveryInclusive  Boolean             @default(false)
  customerRef          String?
  deliveryDate         DateTime?
  vehicleId            Int?
  vehicle              Vehicle?            @relation(fields: [vehicleId], references: [id])
  driverId             Int?
  driver               Driver?             @relation(fields: [driverId], references: [id])
  salesVoucherStatusId Int?
  cancellationReason   String?
  salesVoucherOrders   SalesVoucherOrder[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model SalesVoucherOrder {
  id                        Int                      @id @default(autoincrement())
  salesOrderNumber          String                   @unique
  salesVoucherId            Int
  salesVoucher              SalesVoucher             @relation(fields: [salesVoucherId], references: [id], onDelete: Cascade)
  salesVoucherItemId        Int?
  salesVoucherItem          SalesVoucherItem?        @relation(fields: [salesVoucherItemId], references: [id])
  customerId                Int
  customer                  Customer                 @relation(fields: [customerId], references: [id])
  companyId                 Int
  company                   Company                  @relation(fields: [companyId], references: [id])
  locationId                Int
  location                  Location                 @relation(fields: [locationId], references: [id])
  productId                 Int
  product                   Product                  @relation(fields: [productId], references: [id])
  quantity                  Float
  amountUnitPrice           Float?
  amountVAT                 Float?
  amountTotal               Float?
  salesVoucherOrderStatusId Int                      @default(10) // 10 = Unconfirmed, 20 = Confirmed
  salesVoucherOrderStatus   SalesVoucherOrderStatus? @relation(fields: [salesVoucherOrderStatusId], references: [id])
  customerRef               String?
  destinationId             Int?
  destination               Destination?             @relation(fields: [destinationId], references: [id])
  deliveryType              String?                  @default("EXW")
  salesOrderCreated         DateTime?                @default(now())
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
}

// ----------------------------------------------------------------------------
// 6. Payments, Proof of Payment (PoP) & Multimodal AI Transcriptions
// ----------------------------------------------------------------------------

model Payment {
  id                    Int                    @id @default(autoincrement())
  salesVoucherId        Int?
  salesVoucher          SalesVoucher?          @relation(fields: [salesVoucherId], references: [id])
  customerId            Int?
  customer              Customer?              @relation(fields: [customerId], references: [id])
  paymentReference      String                 @unique
  customReference       String?
  amount                Float
  amountApproved        Float?
  paymentModeId         Int
  paymentMode           PaymentMode            @relation(fields: [paymentModeId], references: [id])
  paymentStatusId       Int                    @default(1) // 1: Pending, 2: Approved, 3: Rejected
  paymentStatus         PaymentStatus?         @relation(fields: [paymentStatusId], references: [id])
  transactionId         String?
  rejectionComment      String?
  availableBalanceRef   String?
  ePaymentCheckOutUrl   String?
  paymentTranscriptions PaymentTranscription[]
  paymentDocuments      PaymentDocument[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model PaymentTranscription {
  id                           Int          @id @default(autoincrement())
  paymentId                    Int
  payment                      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  documentTypeId               Int
  documentType                 DocumentType @relation(fields: [documentTypeId], references: [id])
  bankId                       Int?
  bank                         Bank?        @relation(fields: [bankId], references: [id])
  bankBranchId                 Int?
  bankBranch                   BankBranch?  @relation(fields: [bankBranchId], references: [id])
  amount                       Float?
  depositorName                String?
  depositorContact             String?
  documentDate                 DateTime?
  documentReference            String?
  paymentTranscriptionStatusId Int?         @default(1)
  notes                        String?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
}

model PaymentDocument {
  id           Int      @id @default(autoincrement())
  paymentId    Int
  payment      Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  documentName String
  documentUrl  String
  createdAt    DateTime @default(now())
}
